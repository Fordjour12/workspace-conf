# Enhanced Omarchy Theme for Ghostty
# Matching CSS color scheme

# Font configuration
font-family = CaskaydiaMono Nerd Font
font-size = 11

# Window settings
window-padding-x = 11
window-padding-y = 11
window-decoration = false
background-opacity = 0.95

# Terminal settings
term = xterm-256color
scrollback-limit = 10000

# Keybindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Color scheme from omarchy theme
#background = 1a1b26
#foreground = a9b1d6

# Normal colors
#palette = 0=#32344a
#palette = 1=#f7768e
#palette = 2=#9ece6a
#palette = 3=#e0af68
#palette = 4=#7aa2f7
#palette = 5=#ad8ee6
#palette = 6=#449dab
#palette = 7=#787c99

# Bright colors
#palette = 8=#444b6a
#palette = 9=#ff7a93
#palette = 10=#b9f27c
#palette = 11=#ff9e64
#palette = 12=#7da6ff
#palette = 13=#bb9af7
#palette = 14=#0db9d7
#palette = 15=#acb0d0

# Selection color
#selection-background = 7aa2f7



# Light theme colors matching CSS variables
#background = #fcfcfd
#foreground = #000000

# Cursor colors
#cursor-text = #000000

# Normal ANSI colors - matching CSS theme
#palette = 0=#e8e8e9
#palette = 1=#d0416d
#palette = 2=#3d7c47
#palette = 3=#c77d2e
#palette = 4=#6b3e7e
#palette = 5=#9b59b6
#palette = 6=#2e86de
#palette = 7=#333333

# Bright ANSI colors
palette = 8=#b8b8b9
palette = 9=#e85d75
palette = 10=#5cb85c
palette = 11=#f39c12
palette = 12=#8e44ad
palette = 13=#af7ac5
palette = 14=#5dade2
palette = 15=#f8f9fa

# Selection colors
selection-background = #6b3e7e
selection-foreground = #ffffff

# Dark mode override (uncomment to use dark mode)
 background = #201f23
 foreground = #fcfcfd
 cursor-text = #fcfcfd

 palette = 0=#2b2b2b
 palette = 1=#e85d75
 palette = 2=#5cb85c
 palette = 3=#f39c12
 palette = 4=#8b5a9e
 palette = 5=#af7ac5
 palette = 6=#5dade2
 palette = 7=#d3d3d4  


